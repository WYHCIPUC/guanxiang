   "options_page": "html/preferences.html",
   "permissions": [ "activeTab", "storage", "cookies", "contextMenus", "tabs" ],
   "short_name": "__MSG_appNameShort__",
   "update_url": "https://edge.microsoft.com/extensionwebstorebase/v1/crx",
   "version": "7.6.1",
   "version_name": "7.6.1",
